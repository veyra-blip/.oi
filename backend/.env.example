DATABASE_URL="postgresql://postgres:postgres@localhost:5432/internal_wallet?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
REFRESH_SECRET="replace-with-another-long-random-secret"
PORT=4000
FRONTEND_ORIGIN="http://localhost:5173"

# Paystack secret key. Set this in Render Environment Variables; never put it in the HTML.
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_PAYSTACK_TEST_SECRET

# Termii SMS. Keep TERMII_API_KEY private in Render. The first Sender ID is the backend fallback.
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com/api
TERMII_CHANNEL=dnd
TERMII_SENDER_IDS=VEYRA
# Optional legacy fallback for older code. New internal transfers use TERMII_SENDER_IDS.
# TERMII_SENDER_ID=VEYRA
