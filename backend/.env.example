DATABASE_URL="postgresql://postgres:postgres@localhost:5432/internal_wallet?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
OWNER_SETUP_KEY="replace-with-a-one-time-random-secret-at-least-32-characters"
REFRESH_SECRET="replace-with-at-least-32-different-random-characters"
PORT=4000
FRONTEND_ORIGIN="http://localhost:5173"

# Paystack secret key. Set this in Render Environment Variables; never put it in the HTML.
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_PAYSTACK_TEST_SECRET
TERMII_API_KEY=
TERMII_SENDER_ID=VEYRA
TERMII_SENDER_IDS=VEYRA,VEYRA ALERT
TERMII_CHANNEL=dnd
TERMII_BASE_URL=https://api.ng.termii.com/api

# Optional provider adapters. Leave unset until your contracted provider API is available.
# ACCOUNT_RESOLUTION_API_URL=https://provider.example/api
# ACCOUNT_RESOLUTION_API_KEY=server-side-secret
# PAYOUT_API_URL=https://provider.example/api
# PAYOUT_API_KEY=server-side-secret
# BILL_PAYMENT_API_URL=https://provider.example/api
# BILL_PAYMENT_API_KEY=server-side-secret
# RECOVERY_API_URL=https://provider.example/api
# RECOVERY_API_KEY=server-side-secret

# Identity provider adapters (never log or persist full NIN/face templates)
# IDENTITY_API_URL=https://provider.example/api
# IDENTITY_API_KEY=server-side-secret
# FACE_API_URL=https://provider.example/api
# FACE_API_KEY=server-side-secret

# Bank transfer accounting mode. SIMULATED debits the Veyra ledger and credits the local BankAccount mirror.
BANK_TRANSFER_MODE=SIMULATED
# Set to LIVE only after a real payout provider and reconciliation/webhooks have been tested.
PAYOUT_LIVE_MODE=false

# Bank transfer behavior: SIMULATED (Veyra ledger + internal bank mirror) or LIVE (Paystack payout + webhook reconciliation)
BANK_TRANSFER_MODE=SIMULATED
PAYSTACK_WEBHOOK_URL=https://YOUR-RENDER-SERVICE.onrender.com/api/webhooks/paystack

# WebAuthn screen-lock / biometric origin must exactly match the frontend origin
WEBAUTHN_ORIGIN=https://your-veyra-frontend.example
WEBAUTHN_RP_ID=your-veyra-frontend.example
