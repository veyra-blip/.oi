generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  username      String   @unique
  phone         String   @unique
  email         String   @unique
  passwordHash  String
  pinHash       String
  accountNumber String   @unique
  status        String   @default("ACTIVE")
  wallet        Wallet?
  notifications Notification[]
  sessions      Session[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Wallet {
  id      String   @id @default(cuid())
  userId  String   @unique
  balance Decimal  @default(0)
  status  String   @default("ACTIVE")
  user    User     @relation(fields: [userId], references: [id])
}

model Session {
  id                  String   @id @default(cuid())
  userId              String
  refreshHash         String
  previousRefreshHash String?
  revokedAt           DateTime?
  expiresAt           DateTime
  user                User     @relation(fields: [userId], references: [id])
  createdAt           DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Transaction {
  id                String   @id @default(cuid())
  reference         String   @unique
  senderId          String?
  receiverId        String?
  type              String
  status            String
  amount            Decimal
  total             Decimal
  narration         String?
  recipientName     String?
  recipientAccount  String?
  // SQLite / Prisma connector does not support Json.
  // Store JSON-serialized string instead.
  metadata          String?
  createdAt         DateTime @default(now())
  completedAt       DateTime?
}
